# Variables de entorno de ejemplo para [PROYECTO]
# Copia este archivo a .env y configura los valores reales. NO subas el archivo .env al repositorio.

# Configuración de la Aplicación
PORT=8080
NODE_ENV=development

# Configuración de Base de Datos
DB_HOST=localhost
DB_PORT=5432
DB_USER=usuario
DB_PASS=contraseña
DB_NAME=[PROYECTO]_db
